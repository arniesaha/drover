<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Reference only; stage.py renders owner-only definitions under STAGING_ROOT. -->
<plist version="1.0">
<dict>
<key>Label</key>
<string>com.drover.testflight-harnessd</string>
<key>ProgramArguments</key>
<array>
<string>/usr/bin/env</string>
<string>-i</string>
<string>HOME=&lt;STAGING_ROOT&gt;/home</string>
<string>PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
<string>TMPDIR=&lt;STAGING_ROOT&gt;/tmp</string>
<string>XDG_CONFIG_HOME=&lt;STAGING_HOME&gt;/.config</string>
<string>XDG_CACHE_HOME=&lt;STAGING_ROOT&gt;/cache</string>
<string>XDG_DATA_HOME=&lt;STAGING_HOME&gt;/.local/share</string>
<string>UV_CACHE_DIR=&lt;STAGING_ROOT&gt;/cache/uv</string>
<string>DROVER_RELEASE_ROLE=testflight-staging</string>
<string>DROVER_RELEASE_SHA=&lt;RELEASE_SHA&gt;</string>
<string>DROVER_STAGING_ATTESTATION_PATH=&lt;STAGING_ROOT&gt;/staging-probe.json</string>
<string>&lt;STAGING_ROOT&gt;/worktrees/&lt;RELEASE_SHA&gt;/.venv/bin/drover-harnessd</string>
<string>--config</string>
<string>&lt;STAGING_HOME&gt;/.drover/config.toml</string>
<string>--host-id</string>
<string>testflight-staging-mac-mini</string>
<string>--display-name</string>
<string>TestFlight Staging Mac Mini</string>
<string>--kind</string>
<string>macos</string>
<string>--listen</string>
<string>127.0.0.1:17081</string>
<string>--local-url</string>
<string>http://127.0.0.1:17081</string>
<string>--central-url</string>
<string>http://127.0.0.1:17080</string>
</array>
<key>EnvironmentVariables</key>
<dict>
<key>HOME</key>
<string>&lt;STAGING_ROOT&gt;/home</string>
<key>PATH</key>
<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
<key>TMPDIR</key>
<string>&lt;STAGING_ROOT&gt;/tmp</string>
<key>XDG_CONFIG_HOME</key>
<string>&lt;STAGING_HOME&gt;/.config</string>
<key>XDG_CACHE_HOME</key>
<string>&lt;STAGING_ROOT&gt;/cache</string>
<key>XDG_DATA_HOME</key>
<string>&lt;STAGING_HOME&gt;/.local/share</string>
<key>UV_CACHE_DIR</key>
<string>&lt;STAGING_ROOT&gt;/cache/uv</string>
<key>DROVER_RELEASE_ROLE</key>
<string>testflight-staging</string>
<key>DROVER_RELEASE_SHA</key>
<string>&lt;RELEASE_SHA&gt;</string>
<key>DROVER_STAGING_ATTESTATION_PATH</key>
<string>&lt;STAGING_ROOT&gt;/staging-probe.json</string>
</dict>
<key>WorkingDirectory</key>
<string>&lt;STAGING_ROOT&gt;/workspace</string>
<key>RunAtLoad</key>
<true/>
<key>KeepAlive</key>
<true/>
<key>Umask</key>
<integer>63</integer>
<key>StandardOutPath</key>
<string>&lt;STAGING_ROOT&gt;/logs/com.drover.testflight-harnessd.stdout.log</string>
<key>StandardErrorPath</key>
<string>&lt;STAGING_ROOT&gt;/logs/com.drover.testflight-harnessd.stderr.log</string>
</dict>
</plist>
