---
import '../styles/fonts.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { SITE, NAV, LINKS } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const path = Astro.url.pathname;
const canonical = new URL(path, SITE.url).href;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#071c28" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('drover-theme');
          var dark = saved ? saved === 'dark' : !window.matchMedia('(prefers-color-scheme: light)').matches;
          document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="home" href="/" aria-label="Drover home"><Logo /></a>
        <nav class="nav-desktop" aria-label="Primary">
          {
            NAV.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="actions">
          <a class="gh" href={LINKS.repo} rel="noopener" aria-label="Drover on GitHub">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
              ></path>
            </svg>
            <span>GitHub</span>
          </a>
          <button class="theme" type="button" data-theme-toggle aria-label="Toggle colour theme">
            <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
              <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3 7 7M17 17l1.7 1.7M5.3 18.7 7 17M17 7l1.7-1.7"
                ></path>
              </g>
            </svg>
            <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path fill="currentColor" d="M20.3 14.6A8.6 8.6 0 0 1 9.4 3.7a8.6 8.6 0 1 0 10.9 10.9Z"></path>
            </svg>
          </button>
          <details class="nav-mobile">
            <summary aria-label="Menu">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
              </svg>
            </summary>
            <nav aria-label="Mobile">
              {
                NAV.map((item) => (
                  <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                ))
              }
              <a href={LINKS.repo} rel="noopener">GitHub</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-brand">
          <Logo />
          <p>One interface above your native coding harnesses.</p>
          <p class="fine">{SITE.license} license. This site has no trackers and no third-party requests.</p>
        </div>
        <div class="foot-cols">
          <div>
            <h4>Product</h4>
            <a href="/features/">Features</a>
            <a href="/use-cases/">Use cases</a>
            <a href="/architecture/">Architecture</a>
            <a href="/faq/">FAQ</a>
          </div>
          <div>
            <h4>Docs</h4>
            <a href="/docs/getting-started/">Getting started</a>
            <a href="/docs/api/">HTTP API</a>
            <a href="/docs/mcp/">MCP</a>
            <a href="/docs/security-privacy/">Security and privacy</a>
          </div>
          <div>
            <h4>Project</h4>
            <a href={LINKS.repo} rel="noopener">GitHub</a>
            <a href={LINKS.article} rel="noopener">Launch article</a>
            <a href={LINKS.changelog} rel="noopener">Changelog</a>
            <a href="/contribute/">Contribute</a>
            <a href={LINKS.securityPolicy} rel="noopener">Security policy</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('drover-theme', next);
          } catch {
            /* private mode: theme just will not persist */
          }
        });
      });
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 8px;
    background: var(--text);
    color: var(--bg);
    padding: 0.5rem 0.9rem;
    border-radius: 8px;
    z-index: 100;
  }
  .skip:focus {
    left: 8px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .home {
    text-decoration: none;
    display: inline-flex;
  }
  .nav-desktop {
    display: flex;
    gap: 0.2rem;
    margin-left: 0.5rem;
  }
  .nav-desktop a {
    font-size: 0.93rem;
    font-weight: 500;
    color: var(--text-2);
    text-decoration: none;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
  }
  .nav-desktop a:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .nav-desktop a[aria-current='page'] {
    color: var(--text);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }
  .gh:hover {
    border-color: var(--text);
  }
  .theme,
  .nav-mobile summary {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .theme:hover {
    border-color: var(--text);
  }
  :global(:root[data-theme='dark']) .theme .moon,
  :global(:root[data-theme='light']) .theme .sun {
    display: none;
  }
  .nav-mobile {
    display: none;
    position: relative;
  }
  .nav-mobile summary {
    list-style: none;
  }
  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }
  .nav-mobile nav {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    min-width: 220px;
    display: grid;
    padding: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow);
  }
  .nav-mobile nav a {
    padding: 0.6rem 0.8rem;
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }
  .nav-mobile nav a:hover,
  .nav-mobile nav a[aria-current='page'] {
    background: var(--surface-2);
  }
  @media (max-width: 900px) {
    .nav-desktop,
    .gh {
      display: none;
    }
    .nav-mobile {
      display: block;
    }
  }

  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--bg-2);
    padding-block: 3rem 3.5rem;
    margin-top: 2rem;
  }
  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.6fr);
    gap: 2.5rem;
  }
  .foot-brand p {
    color: var(--text-2);
    font-size: 0.95rem;
    max-width: 38ch;
    margin-top: 0.9rem;
  }
  .foot-brand .fine {
    color: var(--muted);
    font-size: 0.82rem;
  }
  .foot-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .foot-cols h4 {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.8rem;
  }
  .foot-cols a {
    display: block;
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.94rem;
    padding: 0.18rem 0;
  }
  .foot-cols a:hover {
    color: var(--ember);
  }
  @media (max-width: 760px) {
    .foot {
      grid-template-columns: minmax(0, 1fr);
    }
    .foot-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
