---
// Lightweight YouTube facade component (lite-youtube style).
// Does not load third-party scripts, stylesheets, or iframes until the user explicitly clicks play.
// This preserves zero runtime third-party requests on initial page load and keeps mobile Lighthouse >= 90.

interface Props {
  videoId?: string;
  title?: string;
  caption?: string;
}

// TODO: Replace placeholder YouTube video ID with production walkthrough video ID when recorded.
const {
  videoId = 'placeholder-drover-walkthrough',
  title = 'Drover in 3 minutes: Multi-machine fleet and continuity walkthrough',
  caption = '3-minute walkthrough: Orchestrators, fleet execution, and iOS control',
} = Astro.props;
---

<!-- TODO: Replace placeholder YouTube video ID with production video ID when recorded -->
<div class="lyt-wrapper">
  <div
    class="lyt-container"
    data-video-id={videoId}
    data-video-title={title}
    role="region"
    aria-label={title}
  >
    <div class="lyt-poster" aria-hidden="true">
      <div class="lyt-poster-glow"></div>
      <div class="lyt-poster-content">
        <div class="lyt-badge">
          <span class="dot"></span>
          <span>Drover Product Walkthrough</span>
        </div>
        <p class="lyt-title">Drive your coding fleet from your pocket</p>
        <p class="lyt-subtitle">Claude Code · Codex · OpenClaw · Hermes</p>
      </div>
      <div class="lyt-time">3:18</div>
    </div>

    <button type="button" class="lyt-play" aria-label={`Play video: ${title}`}>
      <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
        <path
          class="lyt-play-bg"
          d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"
          fill="#1d667a"
        ></path>
        <path d="M45 24 27 14v20" fill="#f7ebd8"></path>
      </svg>
    </button>
  </div>
  {caption && <p class="lyt-caption">{caption}</p>}
</div>

<script>
  // Dynamic iframe injection only after user click.
  function initLiteYouTube() {
    const containers = document.querySelectorAll('.lyt-container');
    containers.forEach((container) => {
      if (container.getAttribute('data-ready') === 'true') return;
      container.setAttribute('data-ready', 'true');

      const triggerPlay = () => {
        const videoId = container.getAttribute('data-video-id');
        const title = container.getAttribute('data-video-title') || 'Video player';
        if (!videoId) return;

        const iframe = document.createElement('iframe');
        iframe.setAttribute('src', `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?autoplay=1&rel=0`);
        iframe.setAttribute('title', title);
        iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
        iframe.setAttribute('allowfullscreen', 'true');
        iframe.className = 'lyt-iframe';

        container.replaceChildren(iframe);
      };

      const button = container.querySelector('.lyt-play');
      button?.addEventListener('click', (e) => {
        e.preventDefault();
        triggerPlay();
      });
      container.addEventListener('keydown', (e: Event) => {
        const keyEvent = e as KeyboardEvent;
        if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
          keyEvent.preventDefault();
          triggerPlay();
        }
      });
    });
  }

  initLiteYouTube();
  document.addEventListener('astro:page-load', initLiteYouTube);
</script>

<style>
  .lyt-wrapper {
    width: 100%;
    margin-inline: auto;
  }
  .lyt-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-l);
    border: 1px solid var(--line-strong);
    background: var(--code-bg);
    overflow: hidden;
    box-shadow: var(--shadow), 0 20px 40px -15px rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .lyt-poster {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1rem, 3vw, 2rem);
    background: linear-gradient(135deg, rgba(7, 28, 40, 0.96) 0%, rgba(15, 44, 57, 0.94) 50%, rgba(20, 53, 66, 0.9) 100%);
    user-select: none;
  }
  .lyt-poster-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 75% 30%, rgba(232, 140, 80, 0.16) 0%, transparent 60%),
      radial-gradient(circle at 20% 70%, rgba(86, 183, 200, 0.14) 0%, transparent 50%);
    pointer-events: none;
  }
  .lyt-poster-content {
    position: relative;
    z-index: 1;
    max-width: 44ch;
  }
  .lyt-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal);
    background: var(--surface-2);
    border: 1px solid var(--line);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 0.8rem;
  }
  .lyt-badge .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
  }
  .lyt-title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.2;
    margin: 0 0 0.4rem;
  }
  .lyt-subtitle {
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 1.4vw, 0.85rem);
    color: var(--muted);
    margin: 0;
  }
  .lyt-time {
    position: relative;
    z-index: 1;
    align-self: flex-end;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-2);
    background: rgba(0, 0, 0, 0.55);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .lyt-play {
    position: relative;
    z-index: 2;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    display: grid;
    place-items: center;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  .lyt-play-bg {
    transition: fill 0.2s ease;
  }
  .lyt-container:hover .lyt-play {
    transform: scale(1.08);
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.4));
  }
  .lyt-container:hover .lyt-play-bg {
    fill: var(--ember);
  }
  :global(.lyt-iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .lyt-caption {
    font-size: 0.86rem;
    color: var(--muted);
    text-align: center;
    margin-top: 0.75rem;
    margin-bottom: 0;
  }
</style>
