---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import LayerStack from '../components/LayerStack.astro';
import hero from '../assets/drover-hero.png';
import shotFleet from '../assets/screenshots/ios-fleet.png';
import shotLaunch from '../assets/screenshots/ios-launch.png';
import shotCockpit from '../assets/screenshots/ios-cockpit.png';
import shotAnalytics from '../assets/screenshots/ios-analytics.png';
import { LINKS } from '../site';

// The story on this page follows the author's launch article (LINKS.article).
const tax = [
  { title: 'Different habits', body: 'Each harness has its own process, permissions, sign-in and way to resume work.' },
  { title: 'You are the index', body: 'You remember which machine has the work and which terminal waits for an approval.' },
  { title: 'A switch costs the whole story', body: 'To use quota on another subscription, you explain the task again to a different harness.' },
];

const questions = [
  'Which sessions need attention?',
  'Which provider still has quota?',
  'What question or approval blocks progress?',
  'Can I start the task on the right machine?',
  'Can another harness continue without the whole story again?',
];

const gets = [
  { icon: 'phone', title: 'Start and steer from your phone', body: 'Pick a host, a harness and a project. Send turns. Answer approvals.' },
  { icon: 'chart', title: 'See quota before you route', body: 'Provider quota windows sit next to observed activity.' },
  { icon: 'hand', title: 'Hand off without the retelling', body: 'Continue a session on another harness or host. Drover briefs the new session.' },
  { icon: 'loop', title: 'Keep sessions through restarts', body: 'Drover keeps the native session identity and the ordered events.' },
  { icon: 'search', title: 'Give agents your history', body: 'MCP tools return past sessions, open loops and touched files.' },
  { icon: 'profile', title: 'Carry your preferences', body: 'A portable profile reaches each new session, in three privacy tiers.' },
] as const;

const shots = [
  { src: shotFleet, alt: 'Drover iOS fleet view listing three running sessions across two hosts with provider capacity', label: 'Fleet' },
  { src: shotLaunch, alt: 'Drover iOS new session sheet with host, harness, model and reasoning controls', label: 'Launch' },
  { src: shotCockpit, alt: 'Drover iOS cockpit showing observed sessions, token totals and busiest projects', label: 'Cockpit' },
  { src: shotAnalytics, alt: 'Drover iOS analytics view with provider quota windows and usage distributions', label: 'Analytics' },
];
---

<BaseLayout>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Self-hosted · open source · free</span>
        <h1>Drive your coding-agent fleet <span class="hl">from your pocket.</span></h1>
        <p class="lede">
          One interface for Claude Code, Codex, Antigravity and DeepSeek Harness, on machines you own.
        </p>
        <div class="btn-row">
          <a class="btn" href="/docs/getting-started/">Get started</a>
          <a class="btn ghost" href={LINKS.repo} rel="noopener">GitHub</a>
          <a class="text-link" href={LINKS.article} rel="noopener">Read the launch article</a>
        </div>
        <div class="term install">
          <div class="term-bar"><i></i><i></i><i></i><span>macOS or Linux</span></div>
          <pre><code>curl -fsSL {LINKS.installScript} \
  | bash -s -- --control-store managed</code></pre>
        </div>
        <p class="fine">
          Add <code>--dry-run</code> to preview every action. See the{' '}
          <a href="/docs/getting-started/">install guide</a> for other options.
        </p>
      </div>

      <div class="hero-art">
        <Image src={hero} alt="Drover, a white dog, standing watch over three small glowing terminals in a mountain landscape" widths={[420, 640, 900]} sizes="(max-width: 900px) 70vw, 520px" loading="eager" fetchpriority="high" />
        <span class="float f1"><i></i>studio · codex · running</span>
        <span class="float f2"><i class="w"></i>laptop · claude-code · needs you</span>
        <span class="float f3"><i></i>buildbox · agy · running</span>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <span class="eyebrow">The mental tax of switching</span>
      <h2>Every harness is its own world.</h2>
      <p class="lede">
        The native tools are good. The tax comes when you change your habits each time you change the harness.
      </p>
      <div class="grid cols-3 probs">
        {
          tax.map((p, i) => (
            <div class="prob reveal">
              <span class="num">0{i + 1}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap one">
      <div>
        <span class="eyebrow">What Drover is</span>
        <h2>One interface, not one harness.</h2>
        <p class="lede">
          Drover does not replace your harnesses. Each one keeps its own models, tools, credentials and files.
        </p>
        <p class="pull">The common interface is for you.</p>
        <ol class="questions">
          {questions.map((q) => <li>{q}</li>)}
        </ol>
      </div>
      <figure class="phone-frame one-phone reveal">
        <Image src={shotFleet} alt={shots[0].alt} widths={[300, 480, 720]} sizes="(max-width: 900px) 70vw, 320px" />
      </figure>
    </div>
  </section>

  <section class="section band" id="where-drover-fits">
    <div class="wrap">
      <span class="eyebrow">Where Drover fits</span>
      <h2>Orchestrators plan. Harnesses do. Drover connects them.</h2>
      <p class="lede">Hover or tap a layer.</p>
      <div class="fit">
        <LayerStack compact />
      </div>
      <p class="more"><a href="/architecture/#where-drover-fits">See the full model and the architecture</a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">What you get</span>
      <h2>Quota and context are routing state.</h2>
      <p class="lede">You choose the harness and the host. Drover removes the cost of the switch.</p>
      <div class="grid cols-3 gets">
        {
          gets.map((g) => (
            <div class="get reveal">
              <div class="ficon">
                <Icon name={g.icon} />
              </div>
              <h3>{g.title}</h3>
              <p>{g.body}</p>
            </div>
          ))
        }
      </div>
      <p class="more"><a href="/features/">See all features and their status</a></p>
    </div>
  </section>

  <section class="section band">
    <div class="wrap caps">
      <div>
        <span class="eyebrow">Harnesses</span>
        <h2>Drive four. Observe more.</h2>
        <p class="lede">Each driven harness has a structured adapter. A terminal is always available.</p>
      </div>
      <div class="cap-table">
        <div class="cap-row head"><span>Harness</span><span>Drive</span><span>In your history</span></div>
        <div class="cap-row"><span>Claude Code</span><span class="y">yes, with approvals</span><span class="y">yes</span></div>
        <div class="cap-row"><span>Codex</span><span class="y">yes</span><span class="y">yes</span></div>
        <div class="cap-row"><span>Antigravity (agy)</span><span class="y">yes</span><span class="y">yes</span></div>
        <div class="cap-row"><span>DeepSeek Harness</span><span class="y">yes</span><span class="y">yes</span></div>
        <div class="cap-row"><span>OpenClaw</span><span class="n">observe only</span><span class="y">yes, collected</span></div>
        <div class="cap-row"><span>Hermes</span><span class="n">observe only</span><span class="y">yes, collected</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Two planes</span>
      <h2>A command plane and a context plane.</h2>
      <div class="grid cols-2 planes">
        <div class="plane teal">
          <span class="plane-tag">Command plane · live control</span>
          <h3>The host remains authoritative.</h3>
          <p>
            The hub knows the fleet and routes each operation. A daemon on each host owns the agent processes and the
            files.
          </p>
        </div>
        <div class="plane ember">
          <span class="plane-tag">Context plane · durable memory</span>
          <h3>Facts first.</h3>
          <p>
            Each event goes to a PostgreSQL control store, then to a DuckLake lake. Reads verify their source, or they
            refuse.
          </p>
        </div>
      </div>
      <p class="more"><a href="/architecture/">See the architecture</a></p>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <span class="eyebrow">Use cases</span>
      <h2>Try three of them.</h2>
      <div class="grid cols-3">
        <a class="card" href="/use-cases/#continuity">
          <div class="icon"><Icon name="hand" /></div>
          <h3>Pick up where you left off</h3>
          <p>Laptop to desktop to phone.</p>
        </a>
        <a class="card" href="/use-cases/#orchestrator">
          <div class="icon ember"><Icon name="fleet" /></div>
          <h3>One orchestrator, many workers</h3>
          <p>Send tasks to sessions on several hosts.</p>
        </a>
        <a class="card" href="/use-cases/#recall">
          <div class="icon wheat"><Icon name="search" /></div>
          <h3>Ask your history</h3>
          <p>Query past sessions from any agent.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="how-it-differs">
    <div class="wrap">
      <span class="eyebrow">How it differs</span>
      <h2>Good tools, different slices.</h2>
      <div class="grid cols-3 differs">
        <div class="card">
          <h3><a href={LINKS.herdr} rel="noopener">Herdr</a>, SSH and tmux</h3>
          <p>Herdr keeps real terminal sessions alive and lets you reconnect from another device.</p>
          <p class="where">The premise is the terminal, not the phone.</p>
        </div>
        <div class="card">
          <h3>Claude Code remote control</h3>
          <p>It feels native on the phone and keeps the path from thought to action short.</p>
          <p class="where">It covers one harness, with a session that already runs.</p>
        </div>
        <div class="card mine">
          <h3>Drover</h3>
          <p>One way to start, watch, answer and hand off work across harnesses and hosts.</p>
          <p class="where">You host it yourself. It is young, and built for one trusted operator.</p>
        </div>
      </div>
      <p class="fine">
        Based on the author's experience in the <a href={LINKS.article} rel="noopener">launch article</a>. Check each tool's
        documentation for its current features.
      </p>
    </div>
  </section>

  <section class="section band" id="data-residency">
    <div class="wrap hood">
      <div>
        <span class="eyebrow">Local-first</span>
        <h2>The data residency is yours.</h2>
        <p class="lede">You choose where sessions run, where the data is stored and how hosts join the fleet.</p>
      </div>
      <ul class="hood-list">
        <li><Icon name="cloudoff" /><span><strong>No Drover cloud.</strong> The hub, the hosts and the stores run on your hardware.</span></li>
        <li><Icon name="shield" /><span><strong>Private networks only.</strong> Localhost, a private LAN or Tailscale.</span></li>
        <li><Icon name="profile" /><span><strong>One trusted operator.</strong> Drover is not a multi-tenant service.</span></li>
      </ul>
    </div>
  </section>

  <section class="section" id="ios">
    <div class="wrap">
      <span class="eyebrow">iOS app</span>
      <h2>The phone is where you make the next decision.</h2>
      <p class="ios-status">
        <span class="tag beta">Beta</span>
        <span>Free. Build it from source today. A public beta is coming soon.</span>
      </p>
      <div class="shots">
        {
          shots.map((s) => (
            <div class="shot reveal">
              <figure class="phone-frame">
                <Image src={s.src} alt={s.alt} widths={[260, 400, 600]} sizes="(max-width: 700px) 44vw, 250px" />
              </figure>
              <span class="shot-label">{s.label}</span>
            </div>
          ))
        }
      </div>
      <p class="fine center">Real screenshots with demo data.</p>
    </div>
  </section>

  <section class="section cta">
    <div class="wrap-narrow center">
      <h2>Keep the path from thought to action short.</h2>
      <div class="btn-row cta-row">
        <a class="btn" href="/docs/getting-started/">Get started</a>
        <a class="btn ghost" href={LINKS.repo} rel="noopener">GitHub</a>
        <a class="btn ghost" href={LINKS.article} rel="noopener">Launch article</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: var(--glow);
    padding-block: clamp(2rem, 6vw, 5rem) clamp(2.5rem, 6vw, 5rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
  }
  .hero-copy {
    min-width: 0;
  }
  .hl {
    color: var(--ember);
    font-style: italic;
    font-variation-settings: 'wdth' 84;
  }
  .hero .lede {
    margin-bottom: 1.6rem;
  }
  .text-link {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .install {
    margin-top: 2rem;
    max-width: 640px;
  }
  .install pre {
    font-size: 0.8rem;
  }
  .fine {
    font-size: 0.86rem;
    color: var(--muted);
    margin-top: 0.8rem;
  }
  .hero-art {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 520px;
  }
  .hero-art :global(img) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.35));
    animation: bob 7s ease-in-out infinite;
  }
  .float {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow);
    white-space: nowrap;
    animation: bob 6s ease-in-out infinite;
  }
  .float i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
  }
  .float i.w {
    background: var(--ember);
    animation: ping 1.4s ease-in-out infinite;
  }
  .f1 {
    top: 9%;
    right: 0;
    animation-delay: -1s;
  }
  .f2 {
    top: 46%;
    left: -6%;
    animation-delay: -3s;
  }
  .f3 {
    bottom: 6%;
    right: 4%;
    animation-delay: -5s;
  }
  @keyframes bob {
    50% {
      transform: translateY(-9px);
    }
  }
  @keyframes ping {
    50% {
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--ember) 25%, transparent);
    }
  }

  .probs {
    margin-top: 2rem;
  }
  .prob {
    border-top: 2px solid var(--text);
    padding-top: 1rem;
  }
  .prob .num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ember);
  }
  .prob h3 {
    font-size: 1.4rem;
    margin: 0.3rem 0 0.4rem;
  }
  .prob p {
    color: var(--text-2);
    margin: 0;
  }

  .one {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .one-phone {
    width: 100%;
    max-width: 320px;
    justify-self: center;
    transform: rotate(2deg);
  }
  .pull {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 1rem + 1.8vw, 2.1rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ember);
    margin: 1.2rem 0;
  }
  .questions {
    list-style: none;
    counter-reset: q;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .questions li {
    counter-increment: q;
    display: flex;
    gap: 0.8rem;
    align-items: baseline;
    padding: 0.65rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .questions li::before {
    content: counter(q);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--teal);
  }

  .fit {
    margin-top: 1.6rem;
  }
  .more {
    margin: 1.4rem 0 0;
    font-weight: 600;
  }
  .more a::after {
    content: ' ->';
    font-family: var(--font-mono);
  }

  .gets {
    margin-top: 2rem;
    gap: 1.6rem 2rem;
  }
  .get h3 {
    font-size: 1.15rem;
    margin-bottom: 0.25rem;
  }
  .get p {
    font-size: 0.95rem;
    color: var(--text-2);
    margin: 0;
  }
  .ficon {
    width: 26px;
    height: 26px;
    color: var(--ember);
    margin-bottom: 0.6rem;
  }

  .planes {
    margin-top: 1.6rem;
  }
  .plane {
    border-radius: var(--radius-l);
    padding: 1.4rem;
    border: 1.5px solid;
  }
  .plane.teal {
    background: color-mix(in srgb, var(--teal-soft) 60%, var(--surface));
    border-color: color-mix(in srgb, var(--teal) 55%, transparent);
  }
  .plane.ember {
    background: color-mix(in srgb, var(--ember-soft) 55%, var(--surface));
    border-color: color-mix(in srgb, var(--ember) 50%, transparent);
  }
  .plane-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .plane.teal .plane-tag {
    color: var(--teal);
  }
  .plane.ember .plane-tag {
    color: var(--ember);
  }
  .plane h3 {
    font-size: 1.4rem;
    margin: 0.5rem 0;
  }
  .plane p {
    color: var(--text-2);
    margin: 0;
  }

  .caps {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 2.5rem;
    align-items: center;
  }
  .cap-table {
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .cap-row {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
  }
  .cap-row:last-child {
    border-bottom: 0;
  }
  .cap-row.head {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--surface-2);
  }
  .cap-row span:first-child {
    font-weight: 600;
  }
  .cap-row .y {
    color: var(--ok);
  }
  .cap-row .n {
    color: var(--muted);
  }

  .differs {
    margin-top: 1.6rem;
  }
  .differs h3 a {
    color: inherit;
  }
  .differs .where {
    padding-top: 0.6rem;
    border-top: 1px dashed var(--line-strong);
    color: var(--muted);
    font-size: 0.92rem;
  }
  .differs .mine {
    border-color: var(--ember);
    background: color-mix(in srgb, var(--ember-soft) 45%, var(--surface));
  }

  .hood {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
  }
  .hood-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .hood-list li {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
    font-size: 0.95rem;
    color: var(--text-2);
  }
  .hood-list :global(svg) {
    flex: none;
    width: 22px;
    height: 22px;
    color: var(--teal);
    margin-top: 2px;
  }
  .hood-list strong {
    color: var(--text);
  }

  .ios-status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: baseline;
    color: var(--text-2);
  }
  .shots {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.4rem;
    margin-top: 1.6rem;
  }
  .shot {
    display: grid;
    gap: 0.7rem;
    justify-items: center;
  }
  .shot:nth-child(even) {
    transform: translateY(22px);
  }
  .shot-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .shots + .fine {
    margin-top: 2.5rem;
  }

  .cta {
    background: var(--glow);
  }
  .cta-row {
    justify-content: center;
    margin-top: 1.4rem;
  }

  /* Phone and tablet: one column, artwork and banner centred. */
  @media (max-width: 900px) {
    .hero-grid,
    .caps,
    .hood,
    .one {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-copy {
      text-align: center;
    }
    .hero-copy .lede {
      margin-inline: auto;
    }
    .hero-copy .btn-row {
      justify-content: center;
    }
    .hero-copy .install {
      margin-inline: auto;
    }
    .hero-art {
      order: -1;
      max-width: min(70vw, 340px);
      margin-inline: auto;
    }
    .float {
      display: none;
    }
    .one-phone {
      max-width: 260px;
      transform: none;
    }
    .shots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
    .shot:nth-child(even) {
      transform: none;
    }
  }
</style>
