---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="This page wandered off.">
  <section class="section center">
    <div class="wrap-narrow">
      <span class="eyebrow">404</span>
      <h1>This page wandered off.</h1>
      <p class="lede">Go to the home page or the docs.</p>
      <div class="btn-row" style="justify-content:center;margin-top:1.5rem">
        <a class="btn" href="/">Home</a>
        <a class="btn ghost" href="/docs/">Docs</a>
      </div>
    </div>
  </section>
</BaseLayout>
