---
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { LINKS } from '../site';

const themes = { light: 'vitesse-light', dark: 'vitesse-dark' } as const;

const setup = `git clone https://github.com/arniesaha/drover.git
cd drover
uv sync --extra dev
git config core.hooksPath .githooks

export DROVER_CONTROL_DSN='postgresql://USER:PASSWORD@HOST/DATABASE'
uv run drover-server init
uv run drover-server control-store init`;

const run = `# terminal 1: the hub
uv run drover-server run

# terminal 2: a local host
uv run drover-harnessd \\
  --host-id local-dev \\
  --display-name "Local Dev Host" \\
  --kind macos \\
  --listen 127.0.0.1:7081 \\
  --local-url http://127.0.0.1:7081 \\
  --central-url http://127.0.0.1:7080`;

const tests = `uv run pytest -n auto                              # all Python tests
uv run pytest tests/test_check_public_release.py   # one module
uv run black --check .
uv run isort --check-only .
make docs                                          # Markdown links`;

const ios = `brew install xcodegen
cd apps/drover
xcodegen generate
open Drover.xcodeproj`;

const site = `cd site
npm ci
npm run dev    # local preview
npm test       # build, then run the checks`;
---

<BaseLayout title="Contribute" description="Set up a Drover development environment, run the tests and open a pull request.">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Contribute</span>
      <h1>Help build Drover.</h1>
      <p class="lede">
        This page is a summary. <a href={LINKS.contributing} rel="noopener">CONTRIBUTING.md</a> is the reference.
      </p>
      <div class="btn-row" style="margin-top:1.5rem">
        <a class="btn" href={LINKS.goodFirstIssues} rel="noopener">Good first issues</a>
        <a class="btn ghost" href={LINKS.helpWanted} rel="noopener">Help wanted</a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap-narrow prose">
      <h2 id="where-to-start">Where to start</h2>
      <ul>
        <li><code>good first issue</code>: small tasks for new contributors.</li>
        <li><code>documentation</code>: changes to the docs and this site.</li>
        <li><code>help wanted</code>: tasks where the maintainers want help.</li>
      </ul>
      <p>For a feature, open an issue before you write the code.</p>

      <h2 id="dev-setup">Set up a development environment</h2>
      <p>
        You need Python 3.11 or later, <a href="https://docs.astral.sh/uv/" rel="noopener">uv</a>, a PostgreSQL database
        and one agent CLI.
      </p>
      <ol>
        <li>Clone the repository and initialize the hub.</li>
      </ol>
      <Code code={setup} lang="bash" themes={themes} defaultColor={false} />
      <p>
        The <code>core.hooksPath</code> line enables a pre-commit hook. The hook rejects a commit that contains a private
        path, a private address or a credential.
      </p>
      <ol start="2">
        <li>Start the hub and a host.</li>
      </ol>
      <Code code={run} lang="bash" themes={themes} defaultColor={false} />

      <h3 id="ios">iOS app</h3>
      <p>You need Xcode 16 or later.</p>
      <Code code={ios} lang="bash" themes={themes} defaultColor={false} />
      <p>
        Select your Apple development team and run the <code>Drover</code> scheme. See the{' '}
        <a href={LINKS.file('apps/drover/README.md')} rel="noopener">iOS guide</a>.
      </p>

      <h3 id="this-site">This site</h3>
      <p>The site is in <code>site/</code> in the same repository.</p>
      <Code code={site} lang="bash" themes={themes} defaultColor={false} />

      <h2 id="tests">Run the tests</h2>
      <Code code={tests} lang="bash" themes={themes} defaultColor={false} />
      <ul>
        <li>Format Python with Black at line length 88. Sort imports with isort.</li>
        <li>Tests that need PostgreSQL skip when it is not available. Continuous integration (CI) runs them.</li>
      </ul>

      <h2 id="pull-requests">Open a pull request</h2>
      <ol>
        <li>Make sure the tests pass.</li>
        <li>Update the docs for each change a user can see.</li>
        <li>Add an entry below <code>[Unreleased]</code> in <code>CHANGELOG.md</code>.</li>
        <li>Describe the change and how you validated it.</li>
        <li>Identify breaking changes.</li>
      </ol>
      <p>
        Use <a href="https://www.conventionalcommits.org/" rel="noopener">Conventional Commits</a>, for example{' '}
        <code>fix(harnessd): handle PTY session termination gracefully</code>. One reviewer must approve.
      </p>

      <h2 id="conduct">Code of conduct</h2>
      <p>
        Be respectful and professional. See the{' '}
        <a href={`${LINKS.contributing}#code-of-conduct`} rel="noopener">code of conduct</a>.
      </p>

      <h2 id="security">Security reports</h2>
      <p>
        Do not report a vulnerability in a public issue. Follow <a href={LINKS.securityPolicy} rel="noopener">SECURITY.md</a>.
        Do not put credentials, private addresses or session content in an issue.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .prose h2:first-child {
    margin-top: 0;
  }
</style>
