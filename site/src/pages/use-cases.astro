---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContinuityDemo from '../components/demos/ContinuityDemo.astro';
import OrchestratorDemo from '../components/demos/OrchestratorDemo.astro';
import RecallDemo from '../components/demos/RecallDemo.astro';
---

<BaseLayout
  title="Use cases"
  description="Three interactive examples: continue work on another host, run many workers from one orchestrator, and query your session history."
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Use cases</span>
      <h1>Three things to try.</h1>
      <p class="lede">The data is synthetic. The endpoints and tool names are real.</p>
    </div>
  </section>

  <section class="section-tight" id="continuity">
    <div class="wrap">
      <div class="uc-head">
        <span class="uc-n">01</span>
        <div>
          <h2>Pick up where you left off</h2>
          <p class="lede">Continue a session on another host and harness. Answer its approval from your phone.</p>
        </div>
      </div>
      <ContinuityDemo />
      <ul class="uc-notes">
        <li><code>POST /harness/sessions/&#123;id&#125;/continue</code> starts the new session and briefs it.</li>
        <li>Approvals work for Claude Code sessions.</li>
        <li>The project must be at the same path on both hosts.</li>
      </ul>
    </div>
  </section>

  <section class="section-tight band" id="orchestrator">
    <div class="wrap">
      <div class="uc-head">
        <span class="uc-n">02</span>
        <div>
          <h2>One orchestrator, many workers</h2>
          <p class="lede">Your orchestrator plans and reviews. Drover runs the sessions and records them.</p>
        </div>
      </div>
      <OrchestratorDemo />
      <ul class="uc-notes">
        <li>Session launch, turns, fleet status and publication records are in the <a href="/docs/api/">HTTP API</a>.</li>
        <li>Drover does not open, review or merge pull requests.</li>
      </ul>
    </div>
  </section>

  <section class="section-tight" id="recall">
    <div class="wrap">
      <div class="uc-head">
        <span class="uc-n">03</span>
        <div>
          <h2>Ask your history</h2>
          <p class="lede">An agent that connects to the hub can query past sessions. Type a query or select one.</p>
        </div>
      </div>
      <RecallDemo />
      <ul class="uc-notes">
        <li>
          <code>drover_search</code>, <code>drover_recall_bundle</code> and <code>drover_open_loops</code> are real{' '}
          <a href="/docs/mcp/">MCP tools</a>.
        </li>
        <li>This demo ranks by keyword in your browser. It is not the real ranking.</li>
      </ul>
    </div>
  </section>

  <section class="section center">
    <div class="wrap-narrow">
      <h2>Try it with your own sessions.</h2>
      <div class="btn-row" style="justify-content:center;margin-top:1.4rem">
        <a class="btn" href="/docs/getting-started/">Get started</a>
        <a class="btn ghost" href="/architecture/">Architecture</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .uc-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.2rem;
    align-items: start;
    margin-bottom: 1.4rem;
  }
  .uc-n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 1.4rem + 3.5vw, 4.5rem);
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ember);
  }
  .uc-head h2 {
    margin-bottom: 0.4rem;
  }
  .uc-notes {
    margin: 1.2rem 0 0;
    padding-left: 1.2rem;
    font-size: 0.95rem;
    color: var(--text-2);
    max-width: 74ch;
  }
  .uc-notes li {
    margin-bottom: 0.3rem;
  }
  .uc-notes li::marker {
    color: var(--ember);
  }
</style>
