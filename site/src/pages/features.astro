---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { LINKS } from '../site';

type Status = 'today' | 'optin' | 'beta' | 'roadmap';
const statusLabel: Record<Status, string> = {
  today: 'Works today',
  optin: 'Opt-in',
  beta: 'Beta',
  roadmap: 'Roadmap',
};

interface Feature {
  id: string;
  icon: any;
  title: string;
  status: Status;
  lede: string;
  points: string[];
  more?: { href: string; label: string };
}

const features: Feature[] = [
  {
    id: 'harnesses',
    icon: 'terminal',
    title: 'Multi-harness sessions',
    status: 'today',
    lede: 'One way to start, steer and stop a session on each harness.',
    points: [
      'Drive Claude Code, Codex, Antigravity (agy) and DeepSeek Harness through structured adapters.',
      'Use structured chat with interrupt and native resume, or attach to a terminal.',
      'Answer tool approvals for Claude Code. The other adapters do not support approvals.',
      'OpenClaw and Hermes are observed. You cannot launch them from Drover.',
    ],
    more: { href: LINKS.doc('harness-adapter-architecture.md'), label: 'Harness adapter architecture' },
  },
  {
    id: 'fleet',
    icon: 'fleet',
    title: 'Hub and hosts',
    status: 'today',
    lede: 'One hub, and a daemon on each machine that runs agents.',
    points: [
      'The hub keeps the fleet registry and routes each operation.',
      'The host daemon owns the agent processes, terminals and files on its machine.',
      'A host connects directly, or dials out through a relay.',
      'The hub and the hosts run on macOS and Linux.',
    ],
    more: { href: '/docs/getting-started/#add-another-host', label: 'Add another host' },
  },
  {
    id: 'ios',
    icon: 'phone',
    title: 'iOS cockpit',
    status: 'beta',
    lede: 'A native app for iOS 18 and later.',
    points: [
      'See live sessions by host, with provider quota.',
      'Start a session. Send turns. Answer prompts. Hand off. Attach to the terminal.',
      'Pair with a QR code. The credential stays in the iOS Keychain.',
      'Build the app from source. A public beta is coming soon.',
    ],
    more: { href: LINKS.file('apps/drover/README.md'), label: 'iOS build guide' },
  },
  {
    id: 'recall',
    icon: 'search',
    title: 'Recall, search and handoff',
    status: 'today',
    lede: 'The next session can query the history of earlier sessions.',
    points: [
      'Search and replay the events that the hub ingested.',
      'Get a recall bundle: matches, summaries, project briefs and open loops.',
      'Continue a session on another host or harness. Drover briefs the new session.',
      'Each result names its store and the age of its data.',
    ],
    more: { href: '/docs/mcp/', label: 'MCP tools' },
  },
  {
    id: 'summaries',
    icon: 'notes',
    title: 'Session summaries and project briefs',
    status: 'optin',
    lede: 'Optional workers write summaries and briefs with a model you choose.',
    points: [
      'The workers use the Claude Code CLI on a host, or an Anthropic API key.',
      'The workers are idle until you configure a backend.',
      'The provider receives the transcript text that it summarizes.',
    ],
    more: { href: '/docs/configuration/#models-for-summaries-and-embeddings', label: 'Configure model backends' },
  },
  {
    id: 'profile',
    icon: 'profile',
    title: 'Portable profile with privacy tiers',
    status: 'today',
    lede: 'Your preferences and rules reach each new session in fewer than 1,500 tokens.',
    points: [
      'Three tiers: general, trusted and private. An agent sees only its tier.',
      'Agents propose changes. You approve them, and you can revert them.',
      'Markdown import is a dry run by default. Imported items start as private.',
      'The profile requires the PostgreSQL control store.',
    ],
    more: { href: LINKS.doc('portable-profile.md'), label: 'Portable profile guide' },
  },
  {
    id: 'analytics',
    icon: 'chart',
    title: 'Lake analytics',
    status: 'optin',
    lede: 'Usage, projects and quota, from facts you can audit.',
    points: [
      'See tokens for each session, the busiest projects and provider quota windows.',
      'A DuckLake lake holds the facts. You select it explicitly.',
      'Each read has a five-second deadline and a memory limit.',
    ],
    more: { href: '/architecture/#storage', label: 'How storage works' },
  },
  {
    id: 'mcp',
    icon: 'plug',
    title: 'MCP server',
    status: 'today',
    lede: 'Your fleet and its history as Model Context Protocol (MCP) tools.',
    points: [
      'About two dozen drover_* tools cover fleet status, search, recall, briefs and the profile.',
      'Each request requires a bearer credential.',
      'The server listens on loopback only.',
      'Responses have size limits, a deadline and a data watermark.',
    ],
    more: { href: '/docs/mcp/', label: 'MCP setup' },
  },
  {
    id: 'continuity',
    icon: 'loop',
    title: 'Continuity across restarts',
    status: 'today',
    lede: 'A restart or a closed lid does not lose your work.',
    points: [
      'The hub writes each event, its payload and its export intent in one transaction.',
      'A session keeps its native resume identity.',
      'The hub holds a stop request for an offline host until the host confirms it.',
      'The iOS app keeps unsent drafts until it can deliver them.',
    ],
    more: { href: LINKS.doc('session-lifecycle.md'), label: 'Session lifecycle' },
  },
];

const roadmap = [
  { title: 'Remote MCP', body: 'MCP listens on loopback only. A protected remote transport is not available.' },
  { title: 'Host-bound credentials', body: 'A host credential can act as any host. Do not enroll a machine you do not control.' },
  { title: 'Lifecycle enforcement', body: 'Lifecycle scans report idle sessions and stale worktrees. They do not stop or remove anything.' },
  { title: 'Off-site backup', body: 'A verified backup to object storage is designed but not shipped.' },
  { title: 'Public iOS beta', body: 'You build the app from source today.' },
  { title: 'Packaging', body: 'Drover ships as source and a release wheel. Native packages do not exist.' },
];
---

<BaseLayout title="Features" description="What Drover does today, what is opt-in and what is on the roadmap.">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Features and capabilities</span>
      <h1>What Drover does, with a status on each item.</h1>
      <p class="lede">
        <strong>Works today</strong> is on by default. <strong>Opt-in</strong> needs configuration.{' '}
        <strong>Roadmap</strong> is not built.
      </p>
      <nav class="jump" aria-label="Features on this page">
        {features.map((f) => <a href={`#${f.id}`}>{f.title}</a>)}
        <a href="#roadmap">Roadmap</a>
      </nav>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap list">
      {
        features.map((f) => (
          <article class="feature" id={f.id}>
            <div class="f-head">
              <div class="f-icon">
                <Icon name={f.icon} />
              </div>
              <span class={`tag ${f.status}`}>{statusLabel[f.status]}</span>
              <h2>{f.title}</h2>
              <p class="f-lede">{f.lede}</p>
              {f.more && (
                <a class="f-more" href={f.more.href} rel={f.more.href.startsWith('http') ? 'noopener' : undefined}>
                  {f.more.label}
                </a>
              )}
            </div>
            <ul class="f-points">
              {f.points.map((p) => <li>{p}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section band" id="roadmap">
    <div class="wrap">
      <span class="eyebrow">Roadmap</span>
      <h2>Not built yet.</h2>
      <p class="lede">
        These are known gaps, without dates. Follow the <a href={LINKS.issues} rel="noopener">issue tracker</a> and the{' '}
        <a href={LINKS.changelog} rel="noopener">changelog</a>.
      </p>
      <div class="grid cols-3 road">
        {
          roadmap.map((r) => (
            <div class="card">
              <span class="tag roadmap">Roadmap</span>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.6rem;
  }
  .jump a {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text-2);
    text-decoration: none;
    background: var(--surface);
  }
  .jump a:hover {
    border-color: var(--ember);
    color: var(--ember);
  }
  .list {
    display: grid;
  }
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1.5rem 3rem;
    padding-block: 2.6rem;
    border-bottom: 1px solid var(--line);
  }
  .feature:last-child {
    border-bottom: 0;
  }
  .f-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: var(--ember-soft);
    color: var(--ember);
    margin-bottom: 1rem;
  }
  .f-icon :global(svg) {
    width: 24px;
    height: 24px;
  }
  .feature h2 {
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    margin: 0.7rem 0 0.5rem;
  }
  .f-lede {
    color: var(--text-2);
    font-size: 1.05rem;
  }
  .f-more {
    font-weight: 600;
    font-size: 0.93rem;
  }
  .f-more::after {
    content: ' ->';
    font-family: var(--font-mono);
  }
  .f-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }
  .f-points li {
    position: relative;
    padding: 0.75rem 1rem 0.75rem 2.3rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    font-size: 0.96rem;
    color: var(--text-2);
  }
  .f-points li::before {
    content: '';
    position: absolute;
    left: 1rem;
    top: 1.2rem;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--teal);
    transform: rotate(45deg);
  }
  .road {
    margin-top: 2rem;
  }
  .road h3 {
    margin-top: 0.7rem;
  }
  @media (max-width: 860px) {
    .feature {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
