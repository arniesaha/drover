{
  "id": "drover-continuity-owner",
  "name": "Drover Continuity Owner",
  "version": "0.1.0",
  "description": "Explicit report-only continuity transport; no messaging or executor",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": false },
      "mode": { "type": "string", "enum": ["poll_only", "owner"], "default": "poll_only" },
      "droverOrigin": { "type": "string", "format": "uri" },
      "tokenEnvName": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
      "runId": { "type": "string", "minLength": 1, "maxLength": 191, "pattern": "\\S" },
      "ownerSessionKey": { "type": "string", "minLength": 1, "maxLength": 191, "pattern": "^agent:[^\\s]+$" },
      "canarySessionKey": { "type": "string", "minLength": 1, "maxLength": 191, "pattern": "^agent:[^\\s]+$" },
      "authorityScope": { "type": "string", "enum": ["implementation", "integration", "deployment"] },
      "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 5000 }
    },
    "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
    "then": { "required": ["droverOrigin", "tokenEnvName", "runId", "ownerSessionKey", "authorityScope"] }
  }
}
