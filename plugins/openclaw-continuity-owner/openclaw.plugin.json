{
  "id": "drover-continuity-owner",
  "name": "Drover Continuity Owner",
  "version": "0.1.0",
  "description": "Explicit continuity owner transport; no messaging or executor",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false
      },
      "mode": {
        "type": "string",
        "enum": [
          "poll_only",
          "owner"
        ],
        "default": "poll_only"
      },
      "droverOrigin": {
        "type": "string",
        "format": "uri"
      },
      "tokenEnvName": {
        "type": "string",
        "pattern": "^[A-Z_][A-Z0-9_]*$"
      },
      "handoffTokenEnvName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Z_][A-Z0-9_]*$"
      },
      "observerSessionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 191,
        "pattern": "\\S"
      },
      "objective": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "pattern": "\\S"
      },
      "checkpoint": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "pattern": "\\S"
      },
      "runId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 191,
        "pattern": "\\S"
      },
      "ownerSessionKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 191,
        "pattern": "^agent:[^\\s]+$"
      },
      "ownerPrincipal": {
        "type": "string",
        "minLength": 1,
        "maxLength": 191,
        "pattern": "^(?:credential:[^\\s]+|legacy:operator)$"
      },
      "canarySessionKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 191,
        "pattern": "^agent:[^\\s]+$"
      },
      "authorityScope": {
        "type": "string",
        "enum": [
          "implementation",
          "integration",
          "deployment"
        ]
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000,
        "default": 5000
      }
    },
    "if": {
      "properties": {
        "enabled": {
          "const": true
        }
      },
      "required": [
        "enabled"
      ]
    },
    "then": {
      "required": [
        "droverOrigin",
        "tokenEnvName",
        "runId",
        "ownerSessionKey",
        "ownerPrincipal",
        "authorityScope"
      ]
    }
  },
  "contracts": {
    "tools": [
      "drover_continuity_owner"
    ]
  },
  "enabledByDefault": false,
  "activation": {
    "onStartup": false
  },
  "toolMetadata": {
    "drover_continuity_owner": {
      "optional": true,
      "replaySafe": false,
      "sideEffecting": true
    }
  }
}
