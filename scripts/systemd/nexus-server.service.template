[Unit]
Description=Nexus lakehouse — watcher + summarizer + briefs + embeddings + MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@@REPO_DIR@@
EnvironmentFile=-@@NEXUS_HOME@@/env
ExecStart=@@HOME@@/.local/bin/uv run --quiet nexus-server run --mcp-host 0.0.0.0
Restart=on-failure
RestartSec=10
StandardOutput=append:/tmp/nexus-server.log
StandardError=append:/tmp/nexus-server.log

[Install]
WantedBy=default.target
