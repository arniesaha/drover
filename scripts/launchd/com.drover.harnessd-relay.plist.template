<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.drover.harnessd</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO_DIR__/.venv/bin/drover-harnessd</string>
        <string>--host-id</string>
        <string>__HOST_ID__</string>
        <string>--central-url</string>
        <string>__CENTRAL_URL__</string>
        <string>__RELAY_FLAG__</string>
        <string>--listen</string>
        <string>127.0.0.1:7081</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__REPO_DIR__/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/drover/harnessd.out.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/drover/harnessd.err.log</string>

    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>
</dict>
</plist>
